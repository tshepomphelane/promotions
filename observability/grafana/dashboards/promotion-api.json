{
  "editable": false,
  "panels": [
    {
      "id": 1,
      "title": "5-minute SLI (target 99.9%)",
      "type": "stat",
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "promotion_api:request_good:ratio_rate5m",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "p95 latency (target <300 ms)",
      "type": "stat",
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_request_duration_seconds_bucket{job=\"promotion-api\",route=\"/customers/{customer_id}/promotions\"}[$__rate_interval])))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Server-error ratio",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_total{job=\"promotion-api\",route=\"/customers/{customer_id}/promotions\",status_code=~\"5..\"}[$__rate_interval])) / sum(rate(http_server_requests_total{job=\"promotion-api\",route=\"/customers/{customer_id}/promotions\"}[$__rate_interval]))",
          "legendFormat": "5xx ratio",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Database pool pressure",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "db_pool_checked_out{job=\"promotion-api\"}",
          "legendFormat": "checked out",
          "refId": "A"
        },
        {
          "expr": "db_pool_size{job=\"promotion-api\"}",
          "legendFormat": "configured capacity",
          "refId": "B"
        },
        {
          "expr": "rate(db_pool_checkout_timeouts_total{job=\"promotion-api\"}[$__rate_interval])",
          "legendFormat": "checkout timeouts/sec",
          "refId": "C"
        }
      ]
    }
  ],
  "refresh": "5s",
  "schemaVersion": 39,
  "tags": ["slo", "promotion-api", "database"],
  "time": { "from": "now-15m", "to": "now" },
  "title": "Promotion Eligibility — Service Health",
  "uid": "promotion-eligibility",
  "version": 1
}